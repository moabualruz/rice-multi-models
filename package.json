{
  "name": "rice-multi-models",
  "private": true,
  "scripts": {
    "test": "bun test helper tests ./tests/discovery.test.ts ./tests/discovery.integration.test.ts",
    "typecheck": "tsc -p helper/tsconfig.node.json",
    "typecheck:legacy": "tsc -p helper/tsconfig.json --typeRoots ./node_modules/@types",
    "build": "node scripts/build-helper.mjs",
    "build:check": "node scripts/build-helper.mjs --check",
    "test:node": "node --test helper/test/node-*.mjs",
    "test:install": "node scripts/proof-clean-runtime.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:routing": "node scripts/proof-native-routing.mjs",
    "test:adapter": "node scripts/proof-native-adapter.mjs",
    "test:launcher": "node scripts/proof-native-launcher.mjs",
    "test:search": "node scripts/proof-native-search.mjs && node scripts/proof-native-search.mjs fallback",
    "check": "bun run test && bun run typecheck && npm run build:check && npm run test:node && npm run test:install && npm run test:native && npm run test:routing && npm run test:adapter && npm run test:launcher && npm run test:search && git diff --check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
