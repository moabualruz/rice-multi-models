{
  "name": "rice-multi-models",
  "private": true,
  "scripts": {
    "test": "bun test --isolate helper tests",
    "typecheck": "tsc -p helper/tsconfig.node.json",
    "typecheck:hooks": "node scripts/typecheck-hooks.mjs",
    "typecheck:legacy": "tsc -p helper/tsconfig.json --typeRoots ./node_modules/@types",
    "build": "node scripts/build-helper.mjs",
    "build:check": "node scripts/build-helper.mjs --check",
    "test:node": "node --test helper/test/node-*.mjs tests/permission-context.test.mjs",
    "test:install": "node scripts/proof-clean-runtime.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:routing": "node scripts/proof-native-routing.mjs",
    "test:protocols": "node scripts/proof-native-adapter.mjs protocols",
    "test:compaction": "node scripts/proof-public-compaction.mjs",
    "test:permissions": "node scripts/proof-public-permissions.mjs",
    "test:permission-mode": "node scripts/proof-public-permission-mode.mjs",
    "test:search": "node scripts/proof-public-web-search.mjs && node scripts/proof-public-web-fetch.mjs",
    "test:evaluators": "node scripts/proof-public-evaluator-sources.mjs && node scripts/proof-public-evaluators.mjs",
    "test:titles": "node scripts/proof-public-titles.mjs",
    "check": "bun run test && bun run typecheck && npm run typecheck:hooks && npm run build:check && npm run test:node && npm run test:install && npm run test:native && npm run test:routing && npm run test:phases && npm run test:compaction && npm run test:permissions && npm run test:permission-mode && npm run test:search && npm run test:evaluators && npm run test:titles && git diff --check",
    "test:phases": "node scripts/proof-native-adapter.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
