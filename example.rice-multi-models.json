{
  "providers": {
    "ollama": {
      "kind": "openai",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "allowHttp": true,
      "auth": "none",
      "models": {
        "qwen3:8b": {
          "contextWindow": 40960,
          "maxOutputTokens": 8192,
          "maxTokensParam": "max_tokens",
          "tools": [
            "Read",
            "Edit",
            "Write",
            "Bash",
            "Glob",
            "Grep"
          ]
        }
      }
    },
    "lmstudio": {
      "kind": "openai",
      "baseUrl": "http://127.0.0.1:1234/v1",
      "allowHttp": true,
      "auth": "none",
      "models": {
        "qwen/qwen3-8b": {
          "contextWindow": 32768,
          "maxOutputTokens": 4096,
          "maxTokensParam": "max_tokens",
          "tools": [
            "Read",
            "Edit",
            "Write",
            "Bash",
            "Glob",
            "Grep"
          ]
        }
      }
    },
    "llamacpp": {
      "kind": "openai",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "allowHttp": true,
      "auth": "none",
      "models": {
        "local": {
          "contextWindow": 65536,
          "maxOutputTokens": 8192,
          "maxTokensParam": "max_tokens"
        }
      }
    },
    "vllm": {
      "kind": "openai",
      "baseUrl": "http://127.0.0.1:8000/v1",
      "allowHttp": true,
      "auth": "none",
      "models": {
        "Qwen/Qwen3-32B": {
          "contextWindow": 131072,
          "maxOutputTokens": 16384,
          "maxTokensParam": "max_tokens"
        }
      }
    },
    "openrouter": {
      "kind": "openai",
      "baseUrl": "https://openrouter.ai/api/v1",
      "auth": {
        "command": [
          "/usr/bin/security",
          "find-generic-password",
          "-s",
          "rice-multi-models",
          "-a",
          "openrouter",
          "-w"
        ]
      },
      "models": {
        "nvidia/nemotron-3.5-lightning:free": {
          "contextWindow": 1000000,
          "maxOutputTokens": 16000,
          "maxTokensParam": "max_tokens"
        }
      }
    },
    "openai": {
      "kind": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "auth": {
        "command": [
          "/usr/bin/security",
          "find-generic-password",
          "-s",
          "rice-multi-models",
          "-a",
          "openai",
          "-w"
        ]
      },
      "models": {
        "gpt-5": {
          "contextWindow": 400000,
          "maxInputTokens": 272000,
          "maxOutputTokens": 128000,
          "maxTokensParam": "max_completion_tokens",
          "effort": {
            "low": {
              "reasoning_effort": "low"
            },
            "medium": {
              "reasoning_effort": "medium"
            },
            "high": {
              "reasoning_effort": "high"
            }
          }
        }
      }
    },
    "anthropic-api": {
      "kind": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "auth": {
        "command": [
          "/usr/bin/security",
          "find-generic-password",
          "-s",
          "rice-multi-models",
          "-a",
          "anthropic-api",
          "-w"
        ]
      },
      "models": {
        "claude-haiku-5-5": {
          "contextWindow": 200000,
          "maxOutputTokens": 16000,
          "cache": "5m"
        }
      }
    },
    "my-gateway": {
      "kind": "openai",
      "baseUrl": "https://gateway.example.com/v1",
      "auth": {
        "command": [
          "/usr/bin/security",
          "find-generic-password",
          "-s",
          "rice-multi-models",
          "-a",
          "my-gateway",
          "-w"
        ]
      },
      "models": {
        "open-model": {
          "contextWindow": 200000,
          "maxOutputTokens": 32000
        },
        "gpt-model": {
          "kind": "responses",
          "contextWindow": 400000,
          "maxOutputTokens": 32000,
          "params": {
            "reasoning": {
              "summary": "auto"
            }
          },
          "effort": {
            "low": {
              "reasoning": {
                "effort": "low"
              }
            },
            "high": {
              "reasoning": {
                "effort": "high"
              }
            }
          }
        },
        "claude-model": {
          "kind": "anthropic",
          "contextWindow": 200000,
          "maxOutputTokens": 32000
        },
        "gemini-model": {
          "kind": "gemini",
          "contextWindow": 1048576,
          "maxOutputTokens": 32000,
          "params": {
            "generationConfig": {
              "thinkingConfig": {
                "includeThoughts": true
              }
            }
          }
        }
      }
    }
  },
  "aliases": {
    "local": {
      "target": "lmstudio/qwen/qwen3-8b",
      "note": "LM Studio on this machine"
    }
  }
}
